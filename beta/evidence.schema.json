{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/zerodycoder/RaceProof/blob/main/beta/evidence.schema.json",
    "title": "RaceProof anonymized private-beta evidence",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "$schema",
        "schema_version",
        "updated_on",
        "invitation_summary",
        "adoption_cases",
        "feedback"
    ],
    "properties": {
        "$schema": {
            "const": "./evidence.schema.json"
        },
        "schema_version": {
            "const": 1
        },
        "updated_on": {
            "type": [
                "string",
                "null"
            ],
            "format": "date"
        },
        "invitation_summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "invited_projects",
                "reviewed_on"
            ],
            "properties": {
                "invited_projects": {
                    "type": "integer",
                    "minimum": 0
                },
                "reviewed_on": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date"
                }
            }
        },
        "adoption_cases": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/adoptionCase"
            }
        },
        "feedback": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/feedback"
            }
        }
    },
    "$defs": {
        "consent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "anonymized_publication",
                "recorded_on"
            ],
            "properties": {
                "anonymized_publication": {
                    "const": true
                },
                "recorded_on": {
                    "type": "string",
                    "format": "date"
                }
            }
        },
        "adoptionCase": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "case_id",
                "confirmed_month",
                "environment",
                "scenarios",
                "outcomes",
                "feedback_issues",
                "consent"
            ],
            "properties": {
                "case_id": {
                    "type": "string",
                    "pattern": "^beta-[0-9]{3}$"
                },
                "confirmed_month": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
                },
                "environment": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "php",
                        "laravel",
                        "database",
                        "platform"
                    ],
                    "properties": {
                        "php": {
                            "type": "string",
                            "pattern": "^8\\.[2-9](\\.[0-9]+)?$"
                        },
                        "laravel": {
                            "type": "string",
                            "pattern": "^(12|13)(\\.[0-9]+){0,2}$"
                        },
                        "database": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "driver",
                                "version"
                            ],
                            "properties": {
                                "driver": {
                                    "enum": [
                                        "mysql",
                                        "pgsql",
                                        "sqlite",
                                        "other"
                                    ]
                                },
                                "version": {
                                    "type": "string",
                                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,31}$"
                                }
                            }
                        },
                        "platform": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "os",
                                "architecture"
                            ],
                            "properties": {
                                "os": {
                                    "enum": [
                                        "linux",
                                        "wsl2",
                                        "macos",
                                        "windows",
                                        "other"
                                    ]
                                },
                                "architecture": {
                                    "enum": [
                                        "x86_64",
                                        "arm64",
                                        "other"
                                    ]
                                }
                            }
                        }
                    }
                },
                "scenarios": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "enum": [
                            "overselling",
                            "coupon-redemption",
                            "wallet-debit",
                            "quote-acceptance",
                            "unique-constraint",
                            "lock-misuse",
                            "deadlock",
                            "lock-timeout",
                            "custom"
                        ]
                    }
                },
                "outcomes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "kind",
                            "iterations"
                        ],
                        "properties": {
                            "kind": {
                                "enum": [
                                    "broken-reproduced",
                                    "fix-verified",
                                    "regression-added"
                                ]
                            },
                            "iterations": {
                                "type": "integer",
                                "minimum": 1
                            }
                        }
                    }
                },
                "feedback_issues": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "consent": {
                    "$ref": "#/$defs/consent"
                }
            }
        },
        "feedback": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "feedback_id",
                "received_month",
                "category",
                "disposition",
                "issue_number",
                "resolved_by_pr",
                "consent"
            ],
            "properties": {
                "feedback_id": {
                    "type": "string",
                    "pattern": "^feedback-[0-9]{3}$"
                },
                "received_month": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
                },
                "category": {
                    "enum": [
                        "api",
                        "bug",
                        "compatibility",
                        "documentation",
                        "dx",
                        "reporting",
                        "other"
                    ]
                },
                "disposition": {
                    "enum": [
                        "received",
                        "no-change",
                        "actionable",
                        "resolved"
                    ]
                },
                "issue_number": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1
                },
                "resolved_by_pr": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1
                },
                "consent": {
                    "$ref": "#/$defs/consent"
                }
            }
        }
    }
}
