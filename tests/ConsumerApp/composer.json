{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "raceproof/consumer-acceptance",
    "description": "Isolated Laravel application that verifies RaceProof as an installed dependency.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../runtime",
            "options": {
                "symlink": true,
                "versions": {
                    "raceproof/runtime": "1.0.0-beta.1"
                }
            }
        },
        {
            "type": "path",
            "url": "../../",
            "options": {
                "symlink": true,
                "versions": {
                    "raceproof/laravel": "1.0.0-beta.1"
                }
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "raceproof/runtime": "^1.0.0-beta.1@beta"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5",
        "raceproof/laravel": "^1.0.0-beta.1@beta"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "prepare": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_exists('database/consumer.sqlite') || touch('database/consumer.sqlite');\""
        ],
        "check": [
            "@prepare",
            "@php artisan raceproof:doctor",
            "@php artisan test --testsuite=Feature"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "abandoned": "fail"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
