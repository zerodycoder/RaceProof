{
    "name": "raceproof/laravel",
    "description": "Controlled and reproducible concurrency testing for Laravel applications.",
    "keywords": [
        "laravel",
        "testing",
        "concurrency",
        "race-condition"
    ],
    "homepage": "https://github.com/zerodycoder/RaceProof",
    "license": "MIT",
    "type": "library",
    "support": {
        "issues": "https://github.com/zerodycoder/RaceProof/issues",
        "source": "https://github.com/zerodycoder/RaceProof"
    },
    "repositories": [
        {
            "type": "path",
            "url": "runtime",
            "options": {
                "symlink": true,
                "versions": {
                    "raceproof/runtime": "1.0.0-beta.1"
                }
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "raceproof/runtime": "^1.0.0-beta.1@beta",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "symfony/process": "^7.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "laravel/sanctum": "^4.3",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-mutate": "^3.0.5",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "RaceProof\\Laravel\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RaceProof\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:pest": "pest tests/Pest",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:database": "phpunit --testsuite Database",
        "test:mutation": "pest --mutate --covered-only --min=80 --path=src/Support/EnvironmentGuard.php,src/Support/DatabaseSafety.php,src/Support/SensitiveDataRedactor.php,src/Execution/SymfonyWorkerProcess.php,src/Execution/RaceOrchestrator.php,src/Coordination/CoordinatorResolver.php,src/Coordination/FileCoordinatorStore.php,src/Reports/RaceReportFactory.php tests/Integration/SafetyGuardEdgesTest.php tests/Integration/SafetyGuardsTest.php tests/Integration/SensitiveDataRedactorTest.php tests/Unit/SymfonyWorkerProcessStopTest.php tests/Integration/RaceOrchestratorLifecycleTest.php tests/Unit/CoordinatorResolverTest.php tests/Unit/FileCoordinatorStoreTest.php tests/Unit/FileCoordinatorTimelineTest.php tests/Unit/RaceResultReportTest.php tests/Unit/ReportModelTest.php tests/Integration/ReportersTest.php",
        "test:coverage": [
            "@php -r \"is_dir('build/coverage') || mkdir('build/coverage', 0777, true);\"",
            "phpunit --coverage-clover build/coverage/clover.xml",
            "@php tools/check-coverage.php build/coverage/clover.xml 90"
        ],
        "analyse": "phpstan analyse --configuration phpstan.neon.dist --memory-limit=1G",
        "api:check": "@php tools/api/check.php",
        "beta:check": "@php tools/beta/check.php",
        "beta:gate": "@php tools/beta/gate.php",
        "beta:report": "@php tools/beta/report.php",
        "release:audit": "@php tools/audit/check.php",
        "release:audit-report": "@php tools/audit/report.php",
        "release:dry-run": [
            "@php tools/release/dry-run.php",
            "@release:upgrade-dry-run"
        ],
        "release:upgrade-dry-run": "@php tools/release/upgrade-dry-run.php",
        "release:gate": "@php tools/audit/gate.php",
        "consumer:install": "composer update --working-dir=tests/ConsumerApp --prefer-dist --no-interaction --no-progress",
        "consumer:check": [
            "@consumer:install",
            "composer --working-dir=tests/ConsumerApp check"
        ],
        "validate:runtime": "composer --working-dir=runtime validate --strict",
        "format": "pint",
        "format:test": "pint --test",
        "check": [
            "@validate:runtime",
            "@test",
            "@test:pest",
            "@format:test",
            "@analyse",
            "@api:check",
            "@beta:check",
            "@release:audit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "RaceProof\\Laravel\\RaceProofServiceProvider"
            ],
            "aliases": {
                "RacePoint": "RaceProof\\Laravel\\Facades\\RacePoint"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "abandoned": "fail"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
